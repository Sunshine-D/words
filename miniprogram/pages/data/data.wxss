.page {
  min-height: 100vh;
  background: #f5f7fb;
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 20rpx;
  padding-right: 20rpx;
  background: #f5f7fb;
}

.nav__back {
  width: 56rpx;
  font-size: 44rpx;
  color: #3c465e;
  line-height: 1;
}

.nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222b42;
}

.nav__pad {
  width: 56rpx;
}

.body {
  padding: 24rpx 28rpx 60rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
}

.section-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #222b42;
}

.t-weak {
  font-size: 22rpx;
  color: #9aa5bc;
}

/* ---------- 模式选择 ---------- */
.modes {
  display: flex;
}

.mode {
  position: relative;
  flex: 1;
  min-width: 0;
  background: #fff;
  border-radius: 28rpx;
  padding: 34rpx 24rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(35, 53, 96, 0.06);
  border: 3rpx solid transparent;
  transition: border-color 0.18s ease, transform 0.18s ease;
}

.mode + .mode {
  margin-left: 20rpx;
}

.mode--press {
  transform: scale(0.97);
}

.mode--on {
  border-color: #3d6bff;
}

.mode__ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
}

.mode__ico--local {
  background: #8b97b0;
}

.mode__ico--cloud {
  background: linear-gradient(135deg, #5b86ff, #3d6bff);
}

.mode__name {
  margin-top: 20rpx;
  font-size: 29rpx;
  font-weight: 600;
  color: #222b42;
}

.mode__badge {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(61, 107, 255, 0.12);
  color: #3d6bff;
  font-size: 19rpx;
  font-weight: 600;
  vertical-align: middle;
}

.mode__desc {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #8b97b0;
  line-height: 1.5;
}

.mode__flag {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  font-size: 19rpx;
  color: #3d6bff;
  background: #eaefff;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* ---------- 状态 / 概览卡 ---------- */
.card {
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(35, 53, 96, 0.06);
  overflow: hidden;
}

.stat {
  margin-top: 24rpx;
  padding: 10rpx 30rpx;
}

.stat__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f3f9;
}

.stat__row:last-child {
  border-bottom: none;
}

.stat__k {
  font-size: 26rpx;
  color: #6b7794;
}

.stat__v {
  font-size: 26rpx;
  color: #222b42;
  text-align: right;
  max-width: 62%;
}

.stat__v--warn {
  color: #d97706;
}

.stat__v--weak {
  color: #9aa5bc;
  font-size: 23rpx;
}

.overview {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
}

.ov {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov__n {
  font-size: 40rpx;
  font-weight: 600;
  color: #222b42;
  line-height: 1.1;
}

.ov__l {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa5bc;
}

.ov__split {
  width: 1rpx;
  height: 44rpx;
  background: #eef1f7;
}

/* ---------- 提示条 ---------- */
.tip {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  background: #fff5e6;
}

.tip--info {
  background: #eef3ff;
}

.tip__t {
  display: block;
  font-size: 25rpx;
  color: #8a5a1a;
  line-height: 1.5;
}

.tip--info .tip__t {
  color: #2d4fb5;
}

.tip__d {
  display: block;
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #b08b4f;
  line-height: 1.5;
}

.tip--info .tip__d {
  color: #6f8bd6;
}

/* ---------- 操作 ---------- */
.ops {
  margin-top: 40rpx;
  display: flex;
}

.ops__item {
  flex: 1;
}

.ops__item + .ops__item {
  margin-left: 18rpx;
}

.btn-danger {
  background: #fff;
  color: #e5484d;
  border: 2rpx solid #f5c6c7;
}

.foot-tip {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6bfd2;
}

/* ---------- 弹窗 ---------- */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.42);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 34rpx 30rpx;
}

.sheet__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222b42;
  text-align: center;
}

.sheet__desc {
  margin-top: 16rpx;
  font-size: 25rpx;
  color: #6b7794;
  line-height: 1.6;
  text-align: center;
}

.pick {
  margin-top: 30rpx;
}

.pick__item {
  padding: 26rpx 26rpx;
  border-radius: 22rpx;
  background: #f7f9fd;
  display: flex;
  flex-direction: column;
}

.pick__item + .pick__item {
  margin-top: 16rpx;
}

.pick__n {
  font-size: 27rpx;
  font-weight: 600;
  color: #222b42;
}

.pick__d {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8b97b0;
}

.sheet__btns {
  margin-top: 34rpx;
  display: flex;
}

.sheet__btn {
  flex: 1;
}

.sheet__btn + .sheet__btn {
  margin-left: 18rpx;
}
