.review {
  padding-bottom: 60rpx;
}

/* ---------- 概览 ---------- */
.rv-hero {
  padding: 44rpx 0 36rpx;
  text-align: center;
  background: linear-gradient(150deg, #ffb35c 0%, #ff8a3d 100%);
  border-radius: 32rpx;
  color: #fff;
  margin-bottom: 8rpx;
}

.rv-hero__num {
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
}

.rv-hero__label {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.9);
}

.rv-hero__tip {
  margin-top: 16rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 列表 ---------- */
.rv-card {
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
}

.rv-card__head {
  display: flex;
  align-items: center;
}

.rv-card__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #16203a;
}

.rv-card__meta {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9aa5bc;
}

.rv-card__count {
  color: #e8833a;
}

.rv-card__btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  font-size: 24rpx;
}

.rv-preview {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f3f9;
}

.rv-preview__item {
  display: flex;
  align-items: baseline;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
}

.rv-preview__item--press {
  background: #f5f7fb;
}

.rv-preview__en {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: #16203a;
  margin-right: 16rpx;
}

.rv-preview__cn {
  flex: 1;
  font-size: 21rpx;
  color: #8a93a8;
}

.rv-preview__times {
  flex-shrink: 0;
  font-size: 19rpx;
  color: #e8833a;
  margin-left: 14rpx;
}

.empty__circle--ok {
  background: #eafaf0;
}

.empty__circle--ok .empty__icon {
  color: #22a35a;
}
