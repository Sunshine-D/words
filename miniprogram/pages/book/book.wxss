.book {
  padding-top: 24rpx;
}

/* ---------- 概览 ---------- */
.bk-hero {
  padding: 40rpx 36rpx 36rpx;
  border-radius: 36rpx;
  background: linear-gradient(150deg, #5b86ff 0%, #3d6bff 50%, #6a5bff 100%);
  box-shadow: 0 18rpx 44rpx rgba(61, 107, 255, 0.28);
}

.bk-hero__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
}

.bk-hero__meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
}

.bk-hero__bar {
  margin-top: 32rpx;
  height: 14rpx;
  border-radius: 99rpx;
  background: rgba(255, 255, 255, 0.26);
  overflow: hidden;
}

.bk-hero__bar-inner {
  height: 100%;
  border-radius: 99rpx;
  background: #ffffff;
  transition: width 0.35s ease;
}

.bk-hero__foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.8);
}

.bk-hero__pct {
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.bk-hero__btn {
  margin-top: 32rpx;
  height: 92rpx;
  background: #ffffff;
  color: #2b54dd;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(20, 40, 100, 0.16);
}

/* ---------- 设置卡 ---------- */
.set-card {
  padding: 6rpx 28rpx 26rpx;
}

.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
}

.set-row__main {
  flex: 1;
  padding-right: 20rpx;
}

.set-row__label {
  font-size: 28rpx;
  font-weight: 600;
  color: #16203a;
}

.set-row__hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9aa5bc;
  line-height: 1.5;
}

.set-divider {
  height: 1rpx;
  background: #f2f5fa;
}

/* 步进器 */
.stepper {
  display: flex;
  align-items: center;
  background: #f5f7fc;
  border-radius: 18rpx;
  padding: 6rpx;
  flex-shrink: 0;
}

.stepper__btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  background: #fff;
  color: #3d6bff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(35, 53, 96, 0.08);
}

.stepper__btn:active {
  background: #eef3ff;
}

.stepper__val {
  width: 76rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #16203a;
}

/* 分段控件 */
.seg {
  display: flex;
  background: #f5f7fc;
  border-radius: 18rpx;
  padding: 6rpx;
  flex-shrink: 0;
}

.seg__item {
  min-width: 96rpx;
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  color: #6b7794;
  transition: all 0.16s ease;
}

.seg__item--on {
  background: #ffffff;
  color: #2b54dd;
  font-weight: 600;
  box-shadow: 0 3rpx 10rpx rgba(35, 53, 96, 0.1);
}

/* chips */
.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx -6rpx 10rpx;
}

.chip-row--tight {
  margin-top: 0;
}

.chip {
  margin: 6rpx;
  padding: 0 24rpx;
  height: 60rpx;
  border-radius: 30rpx;
  background: #f5f7fc;
  color: #6b7794;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.16s ease;
}

.chip--on {
  background: #eaf0ff;
  color: #2b54dd;
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx #c3d3ff;
}

/* ---------- 批次 ---------- */
.batch-scroll {
  width: 100%;
  white-space: nowrap;
}

.batch-track {
  display: inline-flex;
  padding: 4rpx 0 10rpx;
}

.batch {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  margin-right: 18rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(35, 53, 96, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.batch__no {
  font-size: 34rpx;
  font-weight: 700;
  color: #3c465e;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.batch__range {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #a9b3c7;
}

.batch--done {
  background: #f1fbf6;
}

.batch--done .batch__no {
  color: #16b364;
}

.batch--current {
  background: linear-gradient(140deg, #5b86ff, #3d6bff);
  box-shadow: 0 10rpx 24rpx rgba(61, 107, 255, 0.3);
}

.batch--current .batch__no {
  color: #fff;
}

.batch--current .batch__range {
  color: rgba(255, 255, 255, 0.75);
}

.batch__flag {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  font-size: 20rpx;
  color: #16b364;
}

.batch-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #a9b3c7;
  padding-left: 4rpx;
}

/* 随机卡 */
.random-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
}

.random-card__badge {
  width: 92rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #fff2d9, #ffe4b8);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.random-card__dice {
  font-size: 40rpx;
  font-weight: 700;
  color: #e08b18;
}

.random-card__title {
  font-size: 30rpx;
  font-weight: 600;
}

.random-card__sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9aa5bc;
}

/* ---------- 单词表 ---------- */
.link {
  font-size: 24rpx;
  color: #3d6bff;
  font-weight: 500;
}

.word-list {
  overflow: hidden;
  padding: 6rpx 0;
}

.wrow {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid #f4f6fb;
}

.wrow__no {
  width: 52rpx;
  font-size: 21rpx;
  color: #b6bfd2;
  padding-top: 4rpx;
  flex-shrink: 0;
}

.wrow__en {
  width: 210rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: #16203a;
  word-break: break-word;
  flex-shrink: 0;
}

.wrow__cn {
  flex: 1;
  font-size: 24rpx;
  color: #5a6683;
  line-height: 1.5;
  word-break: break-word;
}

.wrow__more,
.wrow__end {
  padding: 26rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6bfd2;
}

/* ---------- 错词本 ---------- */
.wrong-card {
  padding: 28rpx;
  margin-bottom: 8rpx;
}

.wrong-card__head {
  display: flex;
  align-items: center;
}

.wrong-card__badge {
  flex-shrink: 0;
  width: 76rpx;
  height: 76rpx;
  margin-right: 22rpx;
  border-radius: 22rpx;
  background: #fff3e8;
  color: #e8833a;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wrong-card__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #16203a;
}

.wrong-card__sub {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9aa5bc;
  line-height: 1.45;
}

.wrong-preview {
  margin-top: 24rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f3f9;
}

.wrong-preview__item {
  display: flex;
  align-items: baseline;
  padding: 12rpx 8rpx;
  border-radius: 12rpx;
}

.wrong-preview__item--press {
  background: #f5f7fb;
}

.wrong-preview__en {
  flex-shrink: 0;
  font-size: 25rpx;
  font-weight: 600;
  color: #16203a;
  margin-right: 16rpx;
}

.wrong-preview__cn {
  flex: 1;
  font-size: 21rpx;
  color: #8a93a8;
}

.wrong-preview__times {
  flex-shrink: 0;
  font-size: 19rpx;
  color: #e8833a;
  margin-left: 14rpx;
}

.wrong-card__btns {
  display: flex;
  margin-top: 26rpx;
}

.wrong-card__btn {
  flex: 1;
}

.wrong-card__btn:first-child {
  flex: 0 0 200rpx;
  margin-right: 18rpx;
}

/* ---------- 删除 ---------- */
.danger {
  margin: 50rpx 0 20rpx;
  text-align: center;
  font-size: 25rpx;
  color: #d0554a;
  padding: 24rpx;
}
